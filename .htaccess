# Khurak Fit · server settings (Apache / LiteSpeed hosting)
Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# always use https://khurakfit.com (no www)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://khurakfit.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://khurakfit.com%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|mp4|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "(\.html|\.js|\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
