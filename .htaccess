# Khurak Fit · server settings and security (Apache / LiteSpeed)
Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On

# always https://khurakfit.com (no www)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://khurakfit.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://khurakfit.com%{REQUEST_URI} [L,R=301]

# only normal page requests
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$
RewriteRule ^ - [F,L]

# hide hidden and private files (keep /.well-known for SSL renewals)
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteRule \.(ini|log|sh|sql|bak|old|orig|swp|md|yml|yaml|lock|env|conf|py|php)$ - [R=404,L]

# turn away common attack probes and scanners
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|admin\.php|\.env|vendor/|cgi-bin/) - [R=404,L,NC]
RewriteCond %{QUERY_STRING} (\.\./|%2e%2e|<script|%3Cscript|union.*select|base64_(en|de)code|/etc/passwd|GLOBALS=|_REQUEST=) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|acunetix|wpscan|dirbuster|gobuster|nessus|zgrab|python-requests/[0-1]\.) [NC]
RewriteRule ^ - [F,L]

</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType video/mp4 .mp4
AddType font/woff .woff
AddDefaultCharset utf-8

<IfModule mod_headers.c>
Header unset X-Powered-By
Header always unset X-Powered-By
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://*.firebaseio.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests"
<FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|mp4|woff|woff2|css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "(\.html|sw\.js|\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml font/woff
</IfModule>
